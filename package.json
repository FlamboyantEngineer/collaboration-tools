{
  "name": "@flamboyantengineer/collaboration-tools",
  "version": "0.0.0",
  "description": "Real-time Yjs collaboration: a room server, a client provider and the wire protocol between them, connected to a host through adapters.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/collaboration-tools.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "specs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "cleanup": "node scripts/cleanup.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:package": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo && tsc -p tsconfig.build.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck-src.tsbuildinfo && tsc -p tsconfig.scripts.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck-scripts.tsbuildinfo",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/dev --passWithNoTests",
    "test:watch": "vitest",
    "check:references": "node scripts/check-references.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:git-install": "node scripts/check-git-install.mjs",
    "check": "node scripts/check.mjs",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@y/y": "14.0.0-rc.23",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@y/protocols": "1.0.6-rc.1",
    "lib0": "1.0.0-rc.22",
    "ws": "^8.22.1"
  },
  "peerDependencies": {
    "@y/y": "14.0.0-rc.23"
  }
}
